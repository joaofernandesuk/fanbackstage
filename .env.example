FANBACKSTAGE_ENVIRONMENT=development
FANBACKSTAGE_APP_NAME=FanBackstage
FANBACKSTAGE_WEB_ORIGIN=http://localhost:3000
FANBACKSTAGE_API_ORIGIN=http://localhost:8000
FANBACKSTAGE_DATABASE_URL=postgresql+asyncpg://fanbackstage:fanbackstage@localhost:5432/fanbackstage
FANBACKSTAGE_REDIS_URL=redis://localhost:6379/0
FANBACKSTAGE_POSTGRES_PORT=5432
FANBACKSTAGE_REDIS_PORT=6379
FANBACKSTAGE_SMTP_HOST=localhost
FANBACKSTAGE_SMTP_PORT=1025
FANBACKSTAGE_EMAIL_FROM=no-reply@fanbackstage.local
FANBACKSTAGE_MAILPIT_UI_PORT=8025
FANBACKSTAGE_STORAGE_ENDPOINT_URL=http://localhost:9000
FANBACKSTAGE_STORAGE_ACCESS_KEY=fanbackstage
FANBACKSTAGE_STORAGE_SECRET_KEY=fanbackstage-development-only
FANBACKSTAGE_STORAGE_BUCKET=fanbackstage-private
FANBACKSTAGE_STORAGE_REGION=us-east-1
FANBACKSTAGE_MEDIA_URL_TTL_SECONDS=300
FANBACKSTAGE_MINIO_PORT=9000
FANBACKSTAGE_MINIO_CONSOLE_PORT=9001
FANBACKSTAGE_PAYMENT_PROVIDER=development
# Replace before a shared environment. Production rejects the development provider.
FANBACKSTAGE_PAYMENT_WEBHOOK_SECRET=development-payment-webhook-secret
FANBACKSTAGE_FINANCE_DEFAULT_COMMISSION_BASIS_POINTS=2000
FANBACKSTAGE_CREATOR_EARNINGS_SETTLEMENT_SECONDS=0
# Replace before any shared or production environment. Production refuses this value.
FANBACKSTAGE_SESSION_SECRET=change-me-for-development-only
FANBACKSTAGE_SESSION_COOKIE_NAME=fanbackstage_session
FANBACKSTAGE_COOKIE_SECURE=false
FANBACKSTAGE_SESSION_TTL_HOURS=24
FANBACKSTAGE_LIVEKIT_URL=ws://localhost:7880
FANBACKSTAGE_LIVEKIT_API_KEY=devkey
FANBACKSTAGE_LIVEKIT_API_SECRET=secret
NEXT_PUBLIC_FANBACKSTAGE_API_URL=http://localhost:8000
