FANBACKSTAGE_ENVIRONMENT=development
# Local/test-only creator KYC HTTP completion; staging/production reject true.
FANBACKSTAGE_DEVELOPMENT_KYC_HTTP_ENABLED=false
# Baseline 18+ self-attestation policy. This is not identity or legal-age verification.
FANBACKSTAGE_ADULT_ATTESTATION_VERSION=adult-self-attestation-v1
FANBACKSTAGE_ADULT_ACCESS_COOKIE_NAME=fanbackstage_adult_access
FANBACKSTAGE_ADULT_ACCESS_COOKIE_TTL_HOURS=720
# Durable provider selection. `test` is blocked outside test unless the explicit
# development switch is enabled; production requires VerifyMyAge production mode.
FANBACKSTAGE_AGE_ASSURANCE_PROVIDER=development_self_attestation
FANBACKSTAGE_AGE_TEST_PROVIDER_ENABLED=false
FANBACKSTAGE_AGE_PROVIDER_TIMEOUT_SECONDS=10
FANBACKSTAGE_AGE_PROVIDER_PROBE_MAX_AGE_SECONDS=86400
FANBACKSTAGE_MANUAL_AGE_REVIEW_MAX_DAYS=90
FANBACKSTAGE_VERIFYMYAGE_ENVIRONMENT=sandbox
FANBACKSTAGE_VERIFYMYAGE_CLIENT_ID=
FANBACKSTAGE_VERIFYMYAGE_CLIENT_SECRET=
FANBACKSTAGE_ANONYMOUS_COMPLIANCE_COOKIE_NAME=fanbackstage_compliance_session
FANBACKSTAGE_ANONYMOUS_COMPLIANCE_SESSION_TTL_HOURS=24
# Optional paired settings. Production accepts only a valid HTTP header token
# plus narrow, exact ingress peer CIDRs; catch-all, broad, local, host-bit, and
# duplicate networks are rejected. Keep Uvicorn proxy-header rewriting disabled.
FANBACKSTAGE_TRUSTED_COUNTRY_HEADER=
FANBACKSTAGE_TRUSTED_PROXY_CIDRS=
FANBACKSTAGE_INTERNAL_COUNTRY_HANDOFF_SECRET=
# Development/test default to PT when empty. Production must set an explicitly
# reviewed fallback even when trusted GeoIP headers are configured.
FANBACKSTAGE_COMPLIANCE_FALLBACK_COUNTRY=
FANBACKSTAGE_KYC_PROVIDER=development
FANBACKSTAGE_APP_NAME=FanBackstage
FANBACKSTAGE_WEB_ORIGIN=http://localhost:3000
FANBACKSTAGE_API_ORIGIN=http://localhost:8000
FANBACKSTAGE_DEMO_SEED_ENABLED=true
FANBACKSTAGE_STAGING_DATASET_ENABLED=false
FANBACKSTAGE_DEBUG=false
FANBACKSTAGE_API_DOCS_ENABLED=true
FANBACKSTAGE_PUBLIC_INDEXING_ENABLED=true
FANBACKSTAGE_PRIVATE_ACCESS_GATEWAY_CONFIGURED=false
FANBACKSTAGE_LIVEKIT_WEBHOOK_CONFIGURED=false
FANBACKSTAGE_RELEASE_SHA=development
# Production must use the asyncpg driver and an explicit non-fallback TLS mode, for
# example: postgresql+asyncpg://user:password@db.example/database?ssl=verify-full
# Use `ssl=`, not libpq's `sslmode=` query name; missing/disable/allow/prefer are rejected.
FANBACKSTAGE_DATABASE_URL=postgresql+asyncpg://fanbackstage:fanbackstage@localhost:5432/fanbackstage
FANBACKSTAGE_REDIS_URL=redis://localhost:6379/0
FANBACKSTAGE_POSTGRES_PORT=5432
FANBACKSTAGE_REDIS_PORT=6379
FANBACKSTAGE_SMTP_HOST=localhost
FANBACKSTAGE_SMTP_PORT=1025
# Production requires credentials and exactly one TLS mode. `USE_TLS` is implicit
# TLS (normally port 465); `START_TLS` forces an upgrade (normally port 587).
FANBACKSTAGE_SMTP_USERNAME=
FANBACKSTAGE_SMTP_PASSWORD=
FANBACKSTAGE_SMTP_USE_TLS=false
FANBACKSTAGE_SMTP_START_TLS=false
FANBACKSTAGE_EMAIL_FROM=no-reply@fanbackstage.local
FANBACKSTAGE_NOTIFICATION_WEBHOOK_SECRET=development-notification-webhook-secret
FANBACKSTAGE_MAILPIT_UI_PORT=8025
FANBACKSTAGE_STORAGE_ENDPOINT_URL=http://localhost:9000
# Optional browser-facing signing host when the API reaches storage over a private Docker DNS name.
FANBACKSTAGE_STORAGE_PUBLIC_ENDPOINT_URL=http://localhost:9000
FANBACKSTAGE_STORAGE_ACCESS_KEY=fanbackstage
FANBACKSTAGE_STORAGE_SECRET_KEY=fanbackstage-development-only
FANBACKSTAGE_STORAGE_BUCKET=fanbackstage-private
FANBACKSTAGE_STORAGE_REGION=us-east-1
# Applies to private presigned upload/delivery URLs and is hard-capped at five minutes.
FANBACKSTAGE_MEDIA_URL_TTL_SECONDS=300
FANBACKSTAGE_MINIO_PORT=9000
FANBACKSTAGE_MINIO_CONSOLE_PORT=9001
FANBACKSTAGE_PAYMENT_PROVIDER=development
# Only the development adapter exists. Production remains blocked until a real provider
# command + signed, replay-safe callback adapter is implemented and registered in code.
FANBACKSTAGE_PAYMENT_WEBHOOK_SECRET=development-payment-webhook-secret
FANBACKSTAGE_FINANCE_DEFAULT_COMMISSION_BASIS_POINTS=2000
FANBACKSTAGE_CREATOR_EARNINGS_SETTLEMENT_SECONDS=0
# Replace before any shared or production environment. Production refuses this value.
FANBACKSTAGE_SESSION_SECRET=change-me-for-development-only
FANBACKSTAGE_SESSION_COOKIE_NAME=fanbackstage_session
FANBACKSTAGE_COOKIE_SECURE=false
FANBACKSTAGE_SESSION_TTL_HOURS=24
# Delivery requests are authorised and throttled per client/IP. The budget
# accommodates media-heavy public pages without disabling the throttle.
FANBACKSTAGE_MEDIA_RATE_LIMIT_ATTEMPTS=300
FANBACKSTAGE_MEDIA_RATE_LIMIT_WINDOW_SECONDS=60
FANBACKSTAGE_LIVEKIT_URL=ws://localhost:17880
# Optional server-to-server route when workers cannot reach the browser URL.
FANBACKSTAGE_LIVEKIT_CONTROL_URL=
FANBACKSTAGE_LIVEKIT_API_KEY=devkey
FANBACKSTAGE_LIVEKIT_API_SECRET=fanbackstage-livekit-development-secret-2026
FANBACKSTAGE_STREAMING_REACTION_RATE_LIMIT_ATTEMPTS=8
FANBACKSTAGE_STREAMING_REACTION_RATE_LIMIT_WINDOW_SECONDS=5
FANBACKSTAGE_ERROR_TRACKING_PROVIDER=disabled
FANBACKSTAGE_ERROR_TRACKING_DSN=
FANBACKSTAGE_ERROR_TRACKING_SEND_PII=false
NEXT_PUBLIC_FANBACKSTAGE_API_URL=http://localhost:8000
NEXT_PUBLIC_FANBACKSTAGE_WEB_ORIGIN=http://localhost:3000
