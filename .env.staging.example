# FANBACKSTAGE PRIVATE STAGING — copy to .env.staging outside version control.
# Every <required:...> value must come from the staging secret/configuration store.

# APPLICATION — required
FANBACKSTAGE_ENVIRONMENT=staging
FANBACKSTAGE_APP_NAME=FanBackstage Staging
FANBACKSTAGE_WEB_ORIGIN=https://staging.example.invalid
FANBACKSTAGE_API_ORIGIN=https://api.staging.example.invalid
FANBACKSTAGE_DEBUG=false
FANBACKSTAGE_API_DOCS_ENABLED=false
FANBACKSTAGE_PUBLIC_INDEXING_ENABLED=false
FANBACKSTAGE_PRIVATE_ACCESS_GATEWAY_CONFIGURED=true
FANBACKSTAGE_RELEASE_SHA=<required:immutable-commit-sha>
FANBACKSTAGE_DEMO_SEED_ENABLED=false
FANBACKSTAGE_STAGING_DATASET_ENABLED=false

# DATABASE — required; asyncpg uses ssl=, not sslmode=. verify-full is preferred.
FANBACKSTAGE_DATABASE_URL=postgresql+asyncpg://<required:user>:<required:password>@<required:host>/<required:database>?ssl=verify-full

# REDIS — required, authenticated TLS endpoint
FANBACKSTAGE_REDIS_URL=rediss://:<required:password>@<required:host>:6379/0

# STORAGE — required, private S3-compatible bucket
FANBACKSTAGE_STORAGE_ENDPOINT_URL=https://<required:private-storage-endpoint>
FANBACKSTAGE_STORAGE_PUBLIC_ENDPOINT_URL=https://<required:browser-storage-endpoint>
FANBACKSTAGE_STORAGE_ACCESS_KEY=<required:non-default-access-key-or-workload-id>
FANBACKSTAGE_STORAGE_SECRET_KEY=<required:secret>
FANBACKSTAGE_STORAGE_BUCKET=<required:private-bucket>
FANBACKSTAGE_STORAGE_REGION=<required:region>
FANBACKSTAGE_MEDIA_URL_TTL_SECONDS=300

# MAIL — required private/authenticated sink; no public delivery in this block
FANBACKSTAGE_SMTP_HOST=<required:private-smtp-host>
FANBACKSTAGE_SMTP_PORT=587
FANBACKSTAGE_SMTP_USERNAME=<required:username>
FANBACKSTAGE_SMTP_PASSWORD=<required:password>
FANBACKSTAGE_SMTP_USE_TLS=false
FANBACKSTAGE_SMTP_START_TLS=true
FANBACKSTAGE_EMAIL_FROM=no-reply@staging.example.invalid

# LIVEKIT — required remote staging service and signed webhook registration
FANBACKSTAGE_LIVEKIT_URL=wss://<required:staging-livekit-host>
FANBACKSTAGE_LIVEKIT_API_KEY=<required:key>
FANBACKSTAGE_LIVEKIT_API_SECRET=<required:secret>
FANBACKSTAGE_LIVEKIT_WEBHOOK_CONFIGURED=true
FANBACKSTAGE_LIVEKIT_TOKEN_TTL_SECONDS=300

# PAYMENTS — fictional staging-only provider; no processor account or card data
FANBACKSTAGE_PAYMENT_PROVIDER=staging_sandbox
FANBACKSTAGE_STAGING_PAYMENT_SANDBOX_ENVIRONMENT=STAGING TEST ONLY
FANBACKSTAGE_STAGING_PAYMENT_WEBHOOK_SECRET=<required:strong-staging-only-secret>

# AGE VERIFICATION — adapter selected; credentials remain an external readiness blocker
FANBACKSTAGE_AGE_ASSURANCE_PROVIDER=verifymyage
FANBACKSTAGE_VERIFYMYAGE_ENVIRONMENT=sandbox
FANBACKSTAGE_VERIFYMYAGE_CLIENT_ID=<external:VerifyMyAge-sandbox-client-id>
FANBACKSTAGE_VERIFYMYAGE_CLIENT_SECRET=<external:VerifyMyAge-sandbox-client-secret>
FANBACKSTAGE_AGE_TEST_PROVIDER_ENABLED=false

# KYC — fictional staging-only provider; never identity evidence or documents
FANBACKSTAGE_KYC_PROVIDER=staging_sandbox
FANBACKSTAGE_STAGING_KYC_SANDBOX_ENVIRONMENT=STAGING TEST ONLY
FANBACKSTAGE_STAGING_KYC_WEBHOOK_SECRET=<required:strong-staging-only-secret>
FANBACKSTAGE_DEVELOPMENT_KYC_HTTP_ENABLED=false

# GEOIP — required; edge strips browser input and injects only from these narrow peer CIDRs
FANBACKSTAGE_TRUSTED_COUNTRY_HEADER=X-FanBackstage-Country
FANBACKSTAGE_TRUSTED_PROXY_CIDRS=<required:exact-ingress-cidr>
FANBACKSTAGE_INTERNAL_COUNTRY_HANDOFF_SECRET=<required:strong-secret>
FANBACKSTAGE_COMPLIANCE_FALLBACK_COUNTRY=<required:reviewed-alpha2-country>

# SECURITY — required
FANBACKSTAGE_SESSION_SECRET=<required:strong-random-secret>
FANBACKSTAGE_SESSION_COOKIE_NAME=fanbackstage_staging_session
FANBACKSTAGE_COOKIE_SECURE=true
FANBACKSTAGE_NOTIFICATION_WEBHOOK_SECRET=<required:strong-secret>

# OBSERVABILITY — endpoint/account remains external; never send PII
FANBACKSTAGE_ERROR_TRACKING_PROVIDER=<required:provider-name-or-disabled>
FANBACKSTAGE_ERROR_TRACKING_DSN=<external:staging-error-tracking-endpoint>
FANBACKSTAGE_ERROR_TRACKING_SEND_PII=false

# FRONTEND — required at image build/runtime; never localhost in staging
NEXT_PUBLIC_FANBACKSTAGE_WEB_ORIGIN=https://staging.example.invalid
NEXT_PUBLIC_FANBACKSTAGE_API_URL=https://api.staging.example.invalid

# DEPLOYMENT IMAGE REFERENCES — required by docker-compose.staging.yml
FANBACKSTAGE_API_IMAGE=<required:registry/fanbackstage-api:commit-sha>
FANBACKSTAGE_WEB_IMAGE=<required:registry/fanbackstage-web:commit-sha>
FANBACKSTAGE_PRIVATE_EDGE_NETWORK=<required:pre-created-private-access-gateway-network>
FANBACKSTAGE_STAGING_ENV_FILE=.env.staging
